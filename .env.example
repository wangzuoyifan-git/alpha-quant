# ============================================================
# LLM 配置（阶段四，autonomy_level 总闸门）
# ============================================================
# 执行权总闸门：OFF（默认）/ ADVISORY / ASSIST / COPILOT / AUTO
LLM_AUTONOMY_LEVEL=OFF

# DeepSeek（主力，openai 兼容协议）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# yunwu.ai 聚合平台（fallback，openai 兼容，可访问 Claude/GPT 等）
YUNWU_API_KEY=your_yunwu_api_key_here
YUNWU_BASE_URL=https://yunwu.ai/v1

# Anthropic 官方原生（可选，仅 api.anthropic.com 直连才用此 key）
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================
# 数据源
# ============================================================
TUSHARE_TOKEN=your_tushare_token_here

# ============================================================
# 企业微信机器人 Webhook
# ============================================================
WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=your_key

# ============================================================
# 邮件配置（以 QQ 邮箱为例）
# ============================================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
EMAIL_USER=your_email@qq.com
EMAIL_PASS=your_smtp_auth_code
EMAIL_TO=recipient1@example.com,recipient2@example.com

# ============================================================
# Telegram Bot（可选）
# ============================================================
TELEGRAM_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
