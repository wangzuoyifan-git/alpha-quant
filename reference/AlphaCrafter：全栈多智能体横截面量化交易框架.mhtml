function addCustomElement(def) {
  if (def.is_autonomous) {
      window.customElements.define(def.name, class extends HTMLElement{});
  } else {
    const templateElement =3D document.createElement(def.local_name);
    const baseName =3D Object.getPrototypeOf(templateElement).constructor.n=
ame;
    const ElementBase =3D window[baseName];
